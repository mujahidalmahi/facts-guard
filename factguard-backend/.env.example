APP_NAME=FactGuard API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

FRONTEND_URL=http://localhost:3000

GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL_NAME=gemini-2.5-flash

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

LOG_LEVEL=INFO
LOG_FORMAT=text

CLAIM_MIN_LENGTH=5
CLAIM_MAX_LENGTH=2000

CACHE_TTL=86400
REDIS_URL=redis://default:password@upstash-endpoint.upstash.io:6379

# Groq AI (free — sign up at console.groq.com)
GROQ_API_KEY=

# Bright Data (hackathon — free credits)
BRIGHTDATA_API_KEY=
# Optional: set your SERP zone name manually (auto-discovered if left empty)
# BRIGHTDATA_SERP_ZONE=serp_api1

# Claude API (optional — for credibility stance analysis)
CLAUDE_API_KEY=
CLAUDE_API_KEYS=
